<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/diagnosticsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="🧪 Camera Diagnostic Center"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/capabilitiesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="ℹ️ Full Camera Specs"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/reoptimizeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="⚡ Re-run Optimizer"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/clearCacheRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="🗑️ Clear Cached Profile"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/clearCacheStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="13sp"
        android:textColor="#888888" />

</LinearLayout>
